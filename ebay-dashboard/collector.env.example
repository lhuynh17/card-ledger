# Copy this file to collector.env and fill in the same PocketBase account
# used by Slab Ledger. Do not share collector.env or commit it to Git.
SLAB_POCKETBASE_URL=https://your-pocketbase-host.example
SLAB_POCKETBASE_EMAIL=you@example.com
SLAB_POCKETBASE_PASSWORD=replace-this

# The normal-Chrome extension is the default. The Playwright browser backend
# remains available only for troubleshooting and is not used by the proof.
SLAB_SCRAPER_BACKEND=extension
SLAB_BROWSER_CHANNEL=chrome

# Keep the dedicated browser visible so you can remotely complete a normal
# eBay sign-in or CAPTCHA if one appears. The collector pauses and resumes
# automatically after the page is completed.
SLAB_BROWSER_HEADLESS=0

# One daily cycle begins at this Windows computer's local time. Requests are
# paced over several hours; each card gets one sold and one active lookup.
SLAB_COLLECTOR_DAILY_RUN_TIME=02:00
SLAB_COLLECTOR_MIN_DELAY_MINUTES=2
SLAB_COLLECTOR_MAX_DELAY_MINUTES=4
SLAB_COLLECTOR_DAILY_CEILING=150
SLAB_COLLECTOR_PROOF_LIMIT=0
SLAB_COLLECTOR_EVALUATION_ONLY=1
SLAB_COLLECTOR_CAPTCHA_WAIT_MINUTES=720

# Keep the legacy browser-to-localhost fallback limited to the actual static
# Slab Ledger origin. The Chrome extension is separately pairing-key protected.
SLAB_COLLECTOR_ALLOWED_ORIGIN=https://lhuynh17.github.io
