# Copy this file to collector.env and fill in the same PocketBase account
# used by Slab Ledger. Do not share collector.env or commit it to Git.
SLAB_POCKETBASE_URL=https://your-pocketbase-host.example
SLAB_POCKETBASE_EMAIL=you@example.com
SLAB_POCKETBASE_PASSWORD=replace-this

# Standard Chromium is the default because eBay sold results are rendered in
# the browser. Set to requests only for troubleshooting.
SLAB_SCRAPER_BACKEND=browser

# Keep the dedicated browser visible so you can remotely complete a normal
# eBay sign-in or CAPTCHA if one appears. The collector pauses and resumes
# automatically after the page is completed.
SLAB_BROWSER_HEADLESS=0

# Safe three-card overnight proof of concept. Times use this Windows computer's
# local time. The proof stores candidates locally and cannot replace a trusted
# PocketBase market value.
SLAB_COLLECTOR_START_TIME=02:00
SLAB_COLLECTOR_END_TIME=07:00
SLAB_COLLECTOR_MIN_DELAY_MINUTES=12
SLAB_COLLECTOR_MAX_DELAY_MINUTES=20
SLAB_COLLECTOR_DAILY_CEILING=72
SLAB_COLLECTOR_RESULT_LIMIT=3
SLAB_COLLECTOR_PROOF_LIMIT=3
SLAB_COLLECTOR_EVALUATION_ONLY=1
SLAB_COLLECTOR_CAPTCHA_WAIT_MINUTES=720
