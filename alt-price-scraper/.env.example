SLAB_POCKETBASE_URL=https://your-pocketbase.example
SLAB_ALT_SCRAPER_TOKEN=replace-with-the-token-configured-on-pocketbase
SLAB_POCKETBASE_SUPERUSER_EMAIL=automation@example.invalid
SLAB_POCKETBASE_SUPERUSER_PASSWORD=replace-me
SCRAPE_INTERVAL_MINUTES=1440
SCRAPE_DELAY_MIN_MS=500
SCRAPE_DELAY_MAX_MS=1500
# Optional legacy single delay (used for both min and max if set alone):
# SCRAPE_DELAY_MS=500
ALT_BASE_URL=https://alt.xyz
ALT_BROWSER_CHANNEL=chrome
ALT_BROWSER_PROFILE_PATH=.auth/browser-profile
ALT_STORAGE_STATE_PATH=.auth/storage-state.json
OUTPUT_DIR=output
